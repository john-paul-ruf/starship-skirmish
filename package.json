{
  "name": "starship-skirmish",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, offline, 3D turn-based tactical fleet-combat game — static SPA, no backend.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:determinism": "vitest run tests/determinism",
    "test:catalog-lock": "vitest run tests/unit/catalog",
    "test:fixtures": "vitest run tests/fixtures",
    "test:harness-purity": "tsx tools/balance/purity-check.ts",
    "harness": "tsx tools/balance/cli.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "preact": "^10.24.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/three": "^0.171.0",
    "eslint": "^9.15.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.0.0"
  }
}
